<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.SiteSettingsMapper">

    <resultMap id="SiteSettingsMap" type="com.example.demo.entity.SiteSettings">
        <id column="id" property="id"/>
        <result column="favicon_url" property="faviconUrl"/>
    </resultMap>

    <select id="selectSingleton" resultMap="SiteSettingsMap">
        SELECT id, favicon_url
        FROM site_settings
        WHERE id = 1
    </select>

    <insert id="upsert">
        INSERT INTO site_settings (id, favicon_url)
        VALUES (1, #{row.faviconUrl})
        ON DUPLICATE KEY UPDATE
            favicon_url = VALUES(favicon_url)
    </insert>
</mapper>
