<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.BlogStatsMapper">

    <!-- 分类数：爱好专栏数量（与「我的爱好」一致）；若无 hobbies 表会报错，需先执行建表 SQL -->
    <select id="selectSidebarStats" resultType="com.example.demo.dto.BlogSidebarStats">
        SELECT
            (SELECT COUNT(*) FROM posts) AS postCount,
            (SELECT COUNT(*) FROM hobbies) AS categoryCount,
            (SELECT COUNT(*) FROM post_comments) AS commentCount
    </select>
</mapper>
